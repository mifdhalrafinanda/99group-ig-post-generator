    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst articles = items.map(item => {\n  const rawTitle = item.json.title;\n  const lastDash = rawTitle.lastIndexOf(' - ');\n  const title = lastDash !== -1 ? rawTitle.slice(0, lastDash) : rawTitle;\n  const source = lastDash !== -1 ? rawTitle.slice(lastDash + 3) : 'Tidak diketahui';\n\n  return {\n    title,\n    link: item.json.link,\n    pubDate: new Date(item.json.pubDate),\n    source\n  };\n});\n\narticles.sort((a, b) => b.pubDate - a.pubDate);\n\nconst topArticles = articles.slice(0, 5);\n\nconst combinedText = topArticles\n  .map((a, i) => `${i + 1}. ${a.title} (sumber: ${a.source})\\n${a.link}`)\n  .join('\\n\\n');\n\nreturn [{ json: { combinedText } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        416,
        0
      ],
      "id": "163a4934-4d63-4237-800c-dc77d440caab",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Kamu adalah admin media sosial 99 Group, perusahaan properti. Berdasarkan lima berita properti minggu ini di bawah, buat satu caption Instagram dalam Bahasa Indonesia dengan struktur berikut: satu kalimat hook pembuka yang menarik perhatian, 2-3 kalimat insight yang merangkum tren dari berita-berita ini, satu kalimat call-to-action singkat, dan 5-8 hashtag properti Indonesia yang relevan. Tulis dengan gaya profesional tapi ramah, maksimal 150 kata.\n\nBerita minggu ini:\n{{ $json.combinedText }}",
        "batching": {}
      },
